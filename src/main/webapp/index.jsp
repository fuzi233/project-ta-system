<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>TA Recruit - Home</title>
    <link rel="stylesheet" href="assets/css/style.css"/>
</head>
<body>
<div class="bg-orb orb-a"></div>
<div class="bg-orb orb-b"></div>
<main class="shell">
    <header class="glass hero">
        <p class="eyebrow">BUPT International School</p>
        <h1>TA Recruitment System</h1>
        <p class="subtitle">iPhone-inspired interface, stable text-file backend, agile delivery.</p>
        <div class="hero-links">
            <a class="btn" href="jobs.jsp">Browse Jobs</a>
            <a class="btn ghost" href="mo.jsp">MO Console</a>
            <a class="btn ghost" href="admin.jsp">Admin Workload</a>
        </div>
    </header>

    <section class="grid-3">
        <article class="glass card">
            <h2>TA</h2>
            <p>Find open roles and submit applications with idempotent API behavior.</p>
            <a class="link" href="jobs.jsp">Open TA Page</a>
        </article>
        <article class="glass card">
            <h2>MO</h2>
            <p>Post jobs quickly, keep required skills and module details structured.</p>
            <a class="link" href="mo.jsp">Open MO Page</a>
        </article>
        <article class="glass card">
            <h2>Admin</h2>
            <p>Watch workload distribution and overloaded candidates in real time.</p>
            <a class="link" href="admin.jsp">Open Dashboard</a>
        </article>
    </section>
</main>
<script src="assets/js/app.js"></script>
</body>
</html>
